{
    email admin@counsel.day
    acme_ca https://acme-v02.api.letsencrypt.org/directory
}

counsel.day {
    root * /var/www/counsel.day
    encode gzip zstd

    # Block internal-only paths at the edge. Defence-in-depth: even if a
    # build script accidentally puts these files back on disk, the edge
    # will 404 them. Update this list when adding new internal pages.
    # Both URL forms are listed deliberately: the .html -> extensionless 301
    # below would otherwise turn /homepage.html into /homepage, which would
    # miss a .html-only blocklist and serve the file.
    @blocked path /scripts /scripts/* /og-image-generator /og-image-generator.html /homepage /homepage.html /components /components.html /business-case.pdf /business-case-expanded.pdf
    respond @blocked 404

    # Admin panel · session-based auth via Next.js. Every request to
    # /admin* is forwarded to /api/admin-auth-check first; the endpoint
    # verifies (a) a valid session cookie AND (b) users.is_admin = true.
    # 401/403 → redirect to /signin?next=<original>.
    # Replaces the old Caddy basic-auth gate (removed 2026-05-18) so the
    # admin browser can use the same session cookie to call /api/admin/*.
    @admin path /admin /admin.html /admin-shell.css /admin-* /admin-*.html
    forward_auth @admin 127.0.0.1:3000 {
        uri /api/admin-auth-check
        @admin_fail status 401 403
        handle_response @admin_fail {
            redir * /signin?next={uri}
        }
    }

    # Signed-in app surface · session-cookie auth via Next.js. Every request
    # to these paths is forwarded to /api/auth-check first; 401 → redirect
    # to /signin?next=<original>. The static HTML is then served by Caddy.
    # /invite is intentionally NOT in this list: invitees may follow a link
    # before they have an account, so the preview must be readable without
    # a session. The Accept action 401s server-side and the page JS bounces
    # the user to /signup with a return-to.
    @protected path /account /account.html /billing /billing.html /decisions /decisions.html /decision /decision.html /compose /compose.html /vote-today /vote-today.html /verdict-reveal /verdict-reveal.html
    forward_auth @protected 127.0.0.1:3000 {
        uri /api/auth-check
        copy_headers X-Auth-User-Id
        @auth_fail status 401
        handle_response @auth_fail {
            redir * /signin?next={uri}
        }
    }

    # Dynamic routes · reverse-proxied to the Next.js app (systemd:
    # counsel-day-app, bound to 127.0.0.1:3000). Everything else stays
    # on file_server. Keep this list in sync with the routes Next.js owns.
    @app path /api/* /api
    reverse_proxy @app 127.0.0.1:3000 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Real-IP {remote_host}
        transport http {
            keepalive 30s
        }
    }

    # Counsel Journal was decommissioned 2026-08-09. These URLs used to 301
    # to the homepage, but a mass redirect of retired content to "/" is the
    # textbook soft-404: the destination does not replace the requested page,
    # so Google discards the redirect and reports the URLs as errors anyway.
    # The product is gone for good and nothing replaced it, so the honest
    # status is 410 Gone · it tells crawlers to drop the URLs permanently
    # and stops them being re-crawled indefinitely.
    @journal_retired path /journal /journal.html /journal/* /vault /vault.html /daily /daily.html
    respond @journal_retired 410

    # ---- Consolidation 301s (Aug 2026) ----------------------------------
    # Eight overlapping concept pages were merged into three survivors, and
    # therapists + counsellors became one practitioners page. These are real
    # content moves (the material lives on at the target), so 301 is correct
    # here where the retired Journal above gets a 410.
    @gone_to_how_it_works path /the-experience /the-experience.html /what-youll-see /what-youll-see.html /durations /durations.html
    redir @gone_to_how_it_works /how-it-works permanent

    @gone_to_why_time path /method /method.html /distinction /distinction.html
    redir @gone_to_why_time /why-time permanent

    @gone_to_verdict path /specimen /specimen.html
    redir @gone_to_verdict /verdict permanent

    @gone_to_practitioners path /therapists /therapists.html /counsellors /counsellors.html
    redir @gone_to_practitioners /practitioners permanent

    # ---- One canonical URL form ------------------------------------------
    # try_files below serves BOTH /pricing and /pricing.html with a 200, so
    # every page had two live URLs. Every <link rel="canonical"> on the site
    # points at the extensionless form, so make that the only one that
    # serves: /pricing.html 301s to /pricing, /index.html 301s to /.
    # Caddy sorts `redir` ahead of `try_files` and `file_server` regardless
    # of position in this file, so these fire first.
    @index_html path /index.html
    redir @index_html / permanent

    @html_ext path_regexp htmlext ^/(.+)\.html$
    redir @html_ext /{re.htmlext.1} permanent

    # Legacy crawlers (and a few SEO checkers) request /favicon.ico
    # literally · serve the SVG with a 200 instead of letting them get
    # a 404. Modern browsers use the <link rel="icon"> declarations.
    @favicon_ico path /favicon.ico
    rewrite @favicon_ico /favicon.svg

    try_files {path} {path}.html
    file_server

    # Serve our branded /404.html on 404s and /500.html on 5xx. Without
    # this, Caddy returns its own ugly default page · SEO checkers
    # downgrade us for it and users get a worse landing.
    handle_errors {
        @404 expression `{err.status_code} == 404`
        @5xx expression `{err.status_code} >= 500 && {err.status_code} < 600`
        handle @404 {
            rewrite * /404.html
            file_server
        }
        handle @5xx {
            rewrite * /500.html
            file_server
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        # microphone=(self) allows OUR origin to call getUserMedia() for the
        # voice-input widget on /compose, /vote-today, /verdict-reveal.
        # Previously this was microphone=() which denied EVERY origin including
        # ourselves, so the browser rejected the mic request before showing the
        # permission prompt · silent failure, recurring bug. Camera stays
        # fully denied (we don't use it). interest-cohort + geolocation stay
        # denied site-wide.
        Permissions-Policy "interest-cohort=(), camera=(), microphone=(self), geolocation=()"
        Cross-Origin-Opener-Policy "same-origin"
        # CSP · self-hosted fonts mean we no longer need fonts.googleapis.com
        # (style-src) or fonts.gstatic.com (font-src). Google still appears in
        # script-src/connect-src/frame-src for Analytics + Tag Manager + reCAPTCHA.
        # PostHog (EU region) listed in script-src + connect-src · stays
        # dormant until CD_POSTHOG_KEY is set in posthog.js.
        Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://*.googletagmanager.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/ https://eu-assets.i.posthog.com; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com https://*.analytics.google.com https://www.google.com/recaptcha/ https://eu.i.posthog.com https://eu-assets.i.posthog.com; frame-src https://www.googletagmanager.com https://www.google.com/recaptcha/ https://stats.uptimerobot.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    }

    # ---- Cache-Control · long-cache fingerprintable assets, no-cache HTML ----
    # Long-cache ONLY content-addressed / fingerprintable assets: woff2/woff
    # (Google-pattern hashed names), images, and the JS that hash-assets.py
    # renames to <name>.<hash>.js at deploy. Bust by renaming the file.
    #
    # Explicitly EXCLUDED from immutable (see @revalidate_assets below): every
    # *.css file, plus helper-widget.js / voice-input.js / sw.js. These ship at
    # stable, non-hashed filenames, so an `immutable` year-long cache would pin
    # returning visitors to stale copies across a deploy (the recurring "my CSS
    # edit didn't reach anyone" bug).
    @static_assets {
        path *.woff2 *.woff *.js *.png *.jpg *.jpeg *.svg *.ico *.webp *.avif *.gif
        not path /helper-widget.js /voice-input.js /sw.js
    }
    header @static_assets Cache-Control "public, max-age=31536000, immutable"

    # Mutable assets at stable filenames MUST revalidate so a deploy reaches
    # returning visitors. CSS is not content-hashed (sw.js precaches it by
    # exact name); helper-widget.js + voice-input.js are injected by hardcoded
    # filename; sw.js is the service worker itself. `no-cache` (NOT `no-store`)
    # + Caddy's ETag means the response is usually a cheap 304, never stale.
    @revalidate_assets path *.css /helper-widget.js /voice-input.js /sw.js
    header @revalidate_assets Cache-Control "no-cache, must-revalidate"

    # HTML must never be long-cached · this is how new deploys reach users.
    # `no-cache` (NOT `no-store`) means: revalidate every time, but the browser
    # may use a conditional GET. Combined with Caddy's ETag/Last-Modified the
    # response is usually a 304 with no body · cheap.
    @html path *.html /
    header @html Cache-Control "no-cache, must-revalidate"

    # Catch the well-known + xml + txt files (sitemap, robots, security.txt,
    # llms.txt, manifest, feed) · short cache so updates propagate fast.
    @meta_files path *.xml *.txt /.well-known/* /manifest.webmanifest
    header @meta_files Cache-Control "public, max-age=3600"
}

www.counsel.day {
    redir https://counsel.day{uri} permanent
}
