# Python
__pycache__/
*.pyc
venv/
.venv/

# Node
node_modules/
dist/
build/

# Env files (NEVER commit these, they have your Stripe keys etc)
.env
*.env
!.env.example

# OS junk
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# H1 · Hashed asset copies produced by scripts/hash-assets.py
# Pattern: <name>.<10hex>.<ext> · e.g. nav-toggle.a1b2c3d4e5.js
nav-toggle.*.js
helper-widget.*.js
# helper-widget.*.js does NOT match helper-widget-loader.<hash>.js · the glob
# needs a literal dot after the name. That gap let the loader artifact get
# committed on 2026-08-16. feedback.js joined the hashed set in PR #18 and was
# never listed here at all. Keep this list in step with TRACKED in
# scripts/hash-assets.py.
helper-widget-loader.*.js
feedback.*.js
ga4.*.js
pwa.*.js
!nav-toggle.js
!helper-widget.js
!ga4.js
!pwa.js